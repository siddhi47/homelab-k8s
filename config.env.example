# Copy to config.env and edit for your cluster.
#   cp config.env.example config.env && $EDITOR config.env
# config.env is gitignored.

# --- Node selection -----------------------------------------------------
# Hostnames as shown by `kubectl get nodes`. deploy.sh labels these so the
# manifests can stay generic (they select on homelab.local/gpu + /cpu).
# Set GPU_NODE="" to skip all GPU workloads entirely.
GPU_NODE="my-gpu-node"
CPU_NODE="my-control-node"
# Optional Raspberry Pi (arm64) node, labelled homelab.local/pi=true. Only
# workloads that select that label run there; leave empty if you have none.
PI_NODE=""

# --- Storage ------------------------------------------------------------
# Parent directory on each node for hostPath volumes. Must exist (or be
# creatable) on the node that runs the workload, not on the machine you
# run deploy.sh from.
DATA_ROOT="/var/lib"

# --- Images -------------------------------------------------------------
# Three images are built locally rather than pulled from a registry.
# Point these at the source checkouts on the machine doing the build.
MY_INFER_SRC="$HOME/git/RAG-chatbot"
RESUME_AI_SRC="$HOME/per/resume_ai"
SD_WEBUI_SRC="/tmp/sd-webui"

# Container runtime used for building (podman or docker)
BUILDER="podman"

# --- Airflow ------------------------------------------------------------
# Git repo that git-sync pulls DAGs from (HTTPS; credentials go in
# secrets.env). The branch must have at least one commit. SUBDIR is the
# folder inside the repo holding the DAG files; leave empty for the root.
AIRFLOW_DAGS_REPO="https://github.com/you/dags.git"
AIRFLOW_DAGS_BRANCH="main"
AIRFLOW_DAGS_SUBDIR=""

# --- Access -------------------------------------------------------------
# Node IP used when creating port-forward tunnels + printing access URLs.
CLUSTER_IP="192.168.1.10"

# --- Registry -----------------------------------------------------------
# In-cluster registry (manifests/cpu/registry.yaml), as nodes and your build
# machine reach it. Used by `build-images.sh push`.
REGISTRY="$CLUSTER_IP:30500"
