# Copy to secrets.env, fill in real values, then run scripts/create-secrets.sh
#   cp secrets.env.example secrets.env && $EDITOR secrets.env
#
# secrets.env is gitignored and MUST NOT be committed.
# Values are read straight into kubectl; nothing is echoed to the terminal.

# --- my-secrets  (used by my-infer / RAG chatbot) -----------------------
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- resume-ai-secrets --------------------------------------------------
# Reuses OPENAI_API_KEY / LANGSMITH_* above.
# SECRET_KEY is the Flask session signing key - use a long random string.
SECRET_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_MODE=hosted
GITHUB_USERNAME=

# --- jupyter-token ------------------------------------------------------
# Token you type into the Jupyter login page.
JUPYTER_TOKEN=
